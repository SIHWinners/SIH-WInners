{
  "_note": "Shared by services/core/tests/test_rules_engine.py and packages/contracts/test/rules.test.ts so the Python and TypeScript evaluators cannot drift.",
  "cases": [
    { "logic": { "var": "a" }, "data": { "a": 1 }, "expect": 1 },
    { "logic": { "var": "a.b" }, "data": { "a": { "b": "x" } }, "expect": "x" },
    { "logic": { "var": "list.1" }, "data": { "list": [10, 20] }, "expect": 20 },
    { "logic": { "var": ["missing", 7] }, "data": {}, "expect": 7 },
    { "logic": { "var": "missing" }, "data": {}, "expect": null },
    { "logic": { "var": "" }, "data": { "z": 1 }, "expect": { "z": 1 } },
    { "logic": { "param": "limit" }, "data": {}, "params": { "limit": 500 }, "expect": 500 },
    { "logic": { "==": [1, 1] }, "data": {}, "expect": true },
    { "logic": { "===": ["a", "a"] }, "data": {}, "expect": true },
    { "logic": { "!=": [1, 2] }, "data": {}, "expect": true },
    { "logic": { "!==": [1, 1] }, "data": {}, "expect": false },
    { "logic": { "<": [1, 2] }, "data": {}, "expect": true },
    { "logic": { "<": [1, 2, 3] }, "data": {}, "expect": true },
    { "logic": { "<": [1, 3, 2] }, "data": {}, "expect": false },
    { "logic": { "<=": [2, 2, 3] }, "data": {}, "expect": true },
    { "logic": { ">": [3, 2] }, "data": {}, "expect": true },
    { "logic": { ">=": [2, 3] }, "data": {}, "expect": false },
    { "logic": { "<=": [{ "var": "x" }, 5] }, "data": {}, "expect": false },
    { "logic": { "<=": ["5", 6] }, "data": {}, "expect": false },
    { "logic": { "and": [true, 1, "yes"] }, "data": {}, "expect": "yes" },
    { "logic": { "and": [true, 0, "never"] }, "data": {}, "expect": 0 },
    { "logic": { "and": [] }, "data": {}, "expect": true },
    { "logic": { "or": [false, [], "first"] }, "data": {}, "expect": "first" },
    { "logic": { "or": [0, false] }, "data": {}, "expect": false },
    { "logic": { "or": [] }, "data": {}, "expect": false },
    { "logic": { "!": [[]] }, "data": {}, "expect": true },
    { "logic": { "!!": ["x"] }, "data": {}, "expect": true },
    { "logic": { "!": false }, "data": {}, "expect": true },
    { "logic": { "in": ["sc", ["sc", "obc"]] }, "data": {}, "expect": true },
    { "logic": { "in": ["ell", "hello"] }, "data": {}, "expect": true },
    { "logic": { "in": [{ "var": "c" }, ["sc"]] }, "data": {}, "expect": false },
    { "logic": { "in": ["x", null] }, "data": {}, "expect": false },
    { "logic": { "if": [true, "yes", "no"] }, "data": {}, "expect": "yes" },
    { "logic": { "if": [false, "yes", "no"] }, "data": {}, "expect": "no" },
    { "logic": { "if": [false, 1, true, 2, 3] }, "data": {}, "expect": 2 },
    { "logic": { "if": [false, 1] }, "data": {}, "expect": null },
    { "logic": { "missing": ["a", "b"] }, "data": { "a": 1 }, "expect": ["b"] },
    { "logic": { "+": [1, 2, 3] }, "data": {}, "expect": 6 },
    { "logic": { "*": [2, 3, 4] }, "data": {}, "expect": 24 },
    { "logic": { "-": [10, 4] }, "data": {}, "expect": 6 },
    { "logic": { "-": [5] }, "data": {}, "expect": -5 },
    { "logic": { "/": [7, 2] }, "data": {}, "expect": 3 },
    { "logic": { "min": [4, 2, 9] }, "data": {}, "expect": 2 },
    { "logic": { "max": [4, 2, 9] }, "data": {}, "expect": 9 },
    { "logic": { "+": [1, { "var": "nope" }] }, "data": {}, "expect": null },
    { "logic": { "-": [{ "var": "nope" }, 1] }, "data": {}, "expect": null },
    { "logic": [1, { "var": "a" }], "data": { "a": 2 }, "expect": [1, 2] },
    { "logic": "literal", "data": {}, "expect": "literal" }
  ],
  "errors": [
    { "logic": { "eval": ["x"] } },
    { "logic": { "var": "a", "extra": 1 } },
    { "logic": { "param": "nope" } },
    { "logic": { ">": [1, 2, 3] } },
    { "logic": { "<": [1] } }
  ]
}
