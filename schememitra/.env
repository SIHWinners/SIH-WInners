# SchemeMitra environment. Copy to .env. Every adapter defaults to a safe local/sandbox mode,
# so a fresh clone runs with no credentials and no internet (see docs/DECISIONS.md ADR-001).
# Keep comments on their own lines: dotenv parsers disagree about inline comments.

# dev | test | demo | prod
ENV=dev
# shows the dev OTP on screen and enables demo controls
DEMO_MODE=true

# ── storage profile ────────────────────────────────────────────────────────────
# local profile (default): SQLite + in-memory cache/queue + encrypted local files
DATABASE_URL=sqlite+aiosqlite:///./var/schememitra.db
# compose profile:
# DATABASE_URL=postgresql+asyncpg://schememitra:schememitra@localhost:5432/schememitra
# empty = in-process cache and jobs; e.g. redis://localhost:6379/0
REDIS_URL=
# local | s3
STORAGE_MODE=local
# e.g. http://localhost:9000 (MinIO)
S3_ENDPOINT=
S3_BUCKET=schememitra
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── security ───────────────────────────────────────────────────────────────────
# dev (console OTP issuer) | supabase
AUTH_MODE=dev
# equals SUPABASE_JWT_SECRET in supabase mode
JWT_SECRET=dev-jwt-secret-please-change-0123456789abcdef
# 32-byte base64 key-encryption key; use a KMS-held key in production
DATA_KEK_B64=ZGV2LWtleS1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcyE=
HASH_SALT=dev-salt-rotate-in-prod
INTERNAL_SHARED_SECRET=dev-internal-secret-change-me
# Ed25519 PEM for QR signatures; generated under var/keys in dev when unset
# QR_SIGNING_KEY_PATH=

# ── service wiring ─────────────────────────────────────────────────────────────
CORE_URL=http://127.0.0.1:8000
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
CORS_ORIGINS_CSV=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
OTP_LIMIT_PER_HOUR=60

# ── adapters (spec §13) — SANDBOX modes are labelled in logs and the admin console ─
# sandbox | real
BHASHINI_MODE=sandbox
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# whisper (faster-whisper, installed by `make models`) | none
ASR_FALLBACK=whisper
WHISPER_MODEL=small
# sandbox | real (OAuth2 partner flow)
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/digilocker/callback
# console | msg91 | twilio
SMS_MODE=console
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# off | ollama | openai_compat (external endpoints get PII-redacted text only)
LLM_MODE=off
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
# sandbox | rapidocr (PP-OCR via ONNX, installed by `make models`)
OCR_MODE=sandbox

# ── tunables ───────────────────────────────────────────────────────────────────
READINESS_THRESHOLD=70
PARTNER_RECOVERY_FLOOR=0.70
K_ANONYMITY_MIN=10
IMAGE_PURGE_HOURS=72
